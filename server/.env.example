# MySQL database used by the Pesa Tracker server
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=pesa_tracker

# Partner FitCoach API root; include a version prefix only if the partner uses one
PARTNER_API_URL=https://your-partner-host
# User ID that exists in the partner's FitCoach service
PARTNER_USER_ID=usr_1042

# Keys for consumers of this API, comma-separated. Give each consumer their own key privately.
API_KEYS=your-key-for-team,your-key-for-partner

# Upstream FitCoach API root (no /v1)
FITCOACH_URL=https://your-fitcoach-host
FITCOACH_API_KEY=your-fitcoach-key
RATE_LIMIT_PER_MIN=60
